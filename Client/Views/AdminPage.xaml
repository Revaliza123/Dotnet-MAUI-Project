<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectMaui.Client.Views.AdminPage"
             BackgroundColor="#F4F1EA"
             Title="Admin Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="White"
                    StrokeThickness="0"
                    Margin="0,0,0,12">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="20">
                    <VerticalStackLayout WidthRequest="60" HeightRequest="60">
                        <BoxView BackgroundColor="#E3F2FD" CornerRadius="30"/>
                        <Label Text="📦"
                               FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Manage Products"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Label Text="View and manage all products"
                               FontSize="13"
                               TextColor="Gray"/>
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnProductsTapped"/>
                </Border.GestureRecognizers>
            </Border>

            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="White"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                </Border.Shadow>
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" Padding="20">
                    <VerticalStackLayout WidthRequest="60" HeightRequest="60">
                        <BoxView BackgroundColor="#FFF3E0" CornerRadius="30"/>
                        <Label Text="📂"
                               FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"/>
                    </VerticalStackLayout>
                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                        <Label Text="Manage Categories"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Label Text="View and manage all categories"
                               FontSize="13"
                               TextColor="Gray"/>
                    </VerticalStackLayout>
                </Grid>
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCategoriesTapped"/>
                </Border.GestureRecognizers>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
