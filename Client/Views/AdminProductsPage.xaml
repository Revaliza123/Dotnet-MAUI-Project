<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ProjectMaui.Client.Converters"
             xmlns:models="clr-namespace:ProjectMaui.Domain.Models"
             x:Class="ProjectMaui.Client.Views.AdminProductsPage"
             BackgroundColor="#F4F1EA"
             Title="Products">

    <ContentPage.Resources>
        <converters:ImageConverter x:Key="ImageConverter"/>
    </ContentPage.Resources>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!--  Add Product Button  -->
            <Button Text="+ Add Product"
                    BackgroundColor="#1E3A5F"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="48"
                    FontSize="15"
                    FontAttributes="Bold">
                <Button.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnAddProductClicked"/>
                </Button.GestureRecognizers>
            </Button>

            <!--  Product List  -->
            <CollectionView x:Name="productsItemsView">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Product">
                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                Margin="0,0,0,12">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                            </Border.Shadow>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" Padding="14">
                                <!--  Image  -->
                                <Border Grid.Column="0"
                                        WidthRequest="80"
                                        HeightRequest="80"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="#D1D5DB"
                                        StrokeThickness="0"
                                        VerticalOptions="Center">
                                    <Image Source="{Binding Image, Converter={StaticResource ImageConverter}}"
                                           Aspect="AspectFill"/>
                                </Border>

                                <!--  Info  -->
                                <VerticalStackLayout Grid.Column="1" Spacing="6">
                                    <!--  Name & Actions  -->
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#1E3A5F"
                                               MaxLines="1"/>
                                        <HorizontalStackLayout Grid.Column="1"
                                                               Spacing="4"
                                                               VerticalOptions="Center">
                                            <Button Text="✏️"
                                                    WidthRequest="32"
                                                    HeightRequest="32"
                                                    BackgroundColor="#E3F2FD"
                                                    TextColor="#1E3A5F"
                                                    CornerRadius="8"
                                                    FontSize="12"
                                                    Clicked="OnEditClicked"
                                                    CommandParameter="{Binding Id}"/>
                                            <Button Text="🗑️"
                                                    WidthRequest="32"
                                                    HeightRequest="32"
                                                    BackgroundColor="#FFEBEE"
                                                    TextColor="#D32F2F"
                                                    CornerRadius="8"
                                                    FontSize="12"
                                                    Clicked="OnDeleteClicked"
                                                    CommandParameter="{Binding Id}"/>
                                        </HorizontalStackLayout>
                                    </Grid>

                                    <!--  Status  -->
                                    <Label Text="{Binding Status}"
                                           FontSize="12"
                                           TextColor="Gray"/>

                                    <!--  Price  -->
                                    <Label Text="{Binding Price, StringFormat='Rp {0:N0}'}"
                                           FontSize="15"
                                           FontAttributes="Bold"
                                           TextColor="#1E3A5F"/>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  Empty State  -->
            <VerticalStackLayout x:Name="emptyState"
                                 IsVisible="False"
                                 Spacing="8"
                                 VerticalOptions="Center">
                <Label Text="No products found"
                       FontSize="18"
                       HorizontalOptions="Center"
                       TextColor="#1E3A5F"
                       FontAttributes="Bold"/>
                <Label Text="Click '+ Add Product' to create a new product"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="Gray"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
