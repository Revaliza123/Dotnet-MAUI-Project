<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ProjectMaui.Domain.Models"
             x:Class="ProjectMaui.Client.Views.AdminProductFormPage"
             BackgroundColor="#F4F1EA"
             Title="Product Form">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!--  Form Card  -->
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="White"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                </Border.Shadow>
                <VerticalStackLayout Padding="20" Spacing="14">

                    <!--  Product Type Picker  -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Product Type"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Picker x:Name="TypePicker"
                                BackgroundColor="#F5F5F5"
                                Title="Select product type"
                                SelectedIndexChanged="OnTypeSelected">
                            <Picker.Items>
                                <x:String>Food</x:String>
                                <x:String>Dessert</x:String>
                                <x:String>Drink</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <!--  Name  -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Name"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Entry x:Name="NameEntry"
                               Placeholder="Product name"
                               PlaceholderColor="#9E9E9E"
                               BackgroundColor="#F5F5F5"/>
                    </VerticalStackLayout>

                    <!--  Description  -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Description"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Editor x:Name="DescriptionEditor"
                                Placeholder="Product description"
                                PlaceholderColor="#9E9E9E"
                                HeightRequest="80"
                                BackgroundColor="#F5F5F5"/>
                    </VerticalStackLayout>

                    <!--  Price  -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Price"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Entry x:Name="PriceEntry"
                               Keyboard="Numeric"
                               Placeholder="0.00"
                               PlaceholderColor="#9E9E9E"
                               BackgroundColor="#F5F5F5"/>
                    </VerticalStackLayout>

                    <!--  Stock Quantity  -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Stock Quantity"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Entry x:Name="StockEntry"
                               Keyboard="Numeric"
                               Placeholder="0"
                               PlaceholderColor="#9E9E9E"
                               BackgroundColor="#F5F5F5"/>
                    </VerticalStackLayout>

                    <!--  Ingredients  -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Ingredients"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Entry x:Name="IngredientsEntry"
                               Placeholder="Comma-separated ingredients"
                               PlaceholderColor="#9E9E9E"
                               BackgroundColor="#F5F5F5"/>
                    </VerticalStackLayout>

                    <!--  Preparation Time  -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Preparation Time (minutes)"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Entry x:Name="PrepTimeEntry"
                               Keyboard="Numeric"
                               Placeholder="0"
                               PlaceholderColor="#9E9E9E"
                               BackgroundColor="#F5F5F5"/>
                    </VerticalStackLayout>

                    <!--  Status Picker  -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Status"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Picker x:Name="StatusPicker"
                                BackgroundColor="#F5F5F5"
                                Title="Select status"
                                SelectedIndex="0">
                            <Picker.Items>
                                <x:String>Available</x:String>
                                <x:String>Out of Stock</x:String>
                                <x:String>Discontinued</x:String>
                            </Picker.Items>
                        </Picker>
                    </VerticalStackLayout>

                    <!--  Image Picker  -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Product Image"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <Entry x:Name="ImagePathEntry"
                                   Grid.Column="0"
                                   IsReadOnly="True"
                                   Placeholder="No image selected"
                                   PlaceholderColor="#9E9E9E"
                                   BackgroundColor="#F5F5F5"/>
                            <Button Grid.Column="1"
                                    Text="📷"
                                    BackgroundColor="#1E3A5F"
                                    TextColor="White"
                                    CornerRadius="8"
                                    Clicked="OnPickImageClicked"/>
                        </Grid>

                        <!--  Image Preview  -->
                        <Border HeightRequest="150"
                                WidthRequest="150"
                                HorizontalOptions="Center"
                                StrokeShape="RoundRectangle 12"
                                Stroke="#1E3A5F"
                                StrokeThickness="1"
                                BackgroundColor="#F5F5F5"
                                Margin="0,8,0,0">
                            <Image x:Name="PreviewImage"
                                   Aspect="AspectFill"/>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!--  Action Buttons  -->
            <HorizontalStackLayout Spacing="10" HorizontalOptions="End">
                <Button Text="Cancel"
                        BackgroundColor="#757575"
                        TextColor="White"
                        CornerRadius="20"
                        Padding="20,0"
                        Clicked="OnCancelClicked"/>
                <Button x:Name="SaveButton"
                        Text="Save"
                        BackgroundColor="#1E3A5F"
                        TextColor="White"
                        CornerRadius="20"
                        Padding="20,0"
                        Clicked="OnSaveClicked"/>
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
