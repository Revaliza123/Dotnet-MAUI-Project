<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:converters="clr-namespace:ProjectMaui.Client.Converters"
             x:Class="ProjectMaui.Client.Views.FoodPage"
             BackgroundColor="#F4F1EA"
             Title="Menu GoDahar">

    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:ImageConverter x:Key="ImageConverter"/>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="*, Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="20" Spacing="20">

                <Grid ColumnDefinitions="*, Auto">
                    <VerticalStackLayout Grid.Column="0">
                        <Label Text="GoDahar" FontSize="28" FontAttributes="Bold" TextColor="#1E3A5F" />
                        <Label Text="Pesan makanan favoritmu!" FontSize="14" TextColor="Gray" />
                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            HeightRequest="45"
                            WidthRequest="45"
                            StrokeShape="RoundRectangle 22.5"
                            BackgroundColor="White"
                            StrokeThickness="0">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnCartIconTapped" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Label Text="&#x1F6D2;" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
                            <Label x:Name="CartBadge"
                                    Text="0"
                                    FontSize="10"
                                    FontAttributes="Bold"
                                    TextColor="White"
                                    BackgroundColor="#FF6B35"
                                    WidthRequest="18"
                                    HeightRequest="18"
                                    HorizontalOptions="End"
                                    VerticalOptions="End"
                                    TranslationX="-6"
                                    TranslationY="-6"
                                    IsVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>

                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                    <HorizontalStackLayout Spacing="15">
                        <Button Text="All Menu" Clicked="OnCategoryClicked" BackgroundColor="Transparent" TextColor="#1E3A5F" BorderColor="#1E3A5F" BorderWidth="1" CornerRadius="20" HeightRequest="40" Padding="20,0"/>
                        <Button Text="Food" Clicked="OnCategoryClicked" BackgroundColor="#1E3A5F" TextColor="White" CornerRadius="20" HeightRequest="40" Padding="20,0"/>
                        <Button Text="Drinks" Clicked="OnCategoryClicked" BackgroundColor="Transparent" TextColor="#1E3A5F" BorderColor="#1E3A5F" BorderWidth="1" CornerRadius="20" HeightRequest="40" Padding="20,0"/>
                        <Button Text="Dessert" Clicked="OnCategoryClicked" BackgroundColor="Transparent" TextColor="#1E3A5F" BorderColor="#1E3A5F" BorderWidth="1" CornerRadius="20" HeightRequest="40" Padding="20,0"/>
                    </HorizontalStackLayout>
                </ScrollView>

                <Label Text="Kategori: Food 🍛" FontSize="18" FontAttributes="Bold" TextColor="#1E3A5F" />

                <Label x:Name="EmptyLabel"
                       Text="Belum ada produk makanan"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center"
                       IsVisible="False"
                       Padding="0,30,0,0"/>

                <CollectionView x:Name="MenuCollection"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="2"
                                         VerticalItemSpacing="15"
                                         HorizontalItemSpacing="15"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border StrokeShape="RoundRectangle 20"
                                    BackgroundColor="White"
                                    StrokeThickness="0">
                                <VerticalStackLayout>
                                    <Image Source="{Binding Image, Converter={StaticResource ImageConverter}}"
                                           HeightRequest="120"
                                           Aspect="AspectFill"
                                           BackgroundColor="#D1D5DB"/>
                                    <StackLayout Padding="12">
                                        <Label Text="{Binding Name}"
                                               FontSize="16"
                                               FontAttributes="Bold"
                                               TextColor="#1E3A5F"
                                               MaxLines="1"/>
                                        <Label Text="{Binding Price, StringFormat='Rp {0:N0}'}"
                                               FontSize="14"
                                               FontAttributes="Bold"
                                               TextColor="#1E3A5F"
                                               Margin="0,10,0,0"/>
                                        <Button Text="+"
                                                CommandParameter="{Binding .}"
                                                Clicked="OnAddToCartClicked"
                                                BackgroundColor="#1E3A5F"
                                                TextColor="White"
                                                HorizontalOptions="End"
                                                WidthRequest="40"
                                                CornerRadius="20"/>
                                    </StackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Floating Bottom Cart Bar -->
        <Border x:Name="CartBottomBar"
                Grid.Row="1"
                IsVisible="False"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="#1E3A5F"
                StrokeThickness="0"
                Margin="20,0"
                Padding="0">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnCartBottomBarTapped"/>
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" Padding="16,14">
                <Label Text="&#x1F6D2;"
                        FontSize="22"
                        VerticalOptions="Center"/>
                <VerticalStackLayout Grid.Column="1" Spacing="0">
                    <Label x:Name="CartItemCountLabel"
                            Text="0 item"
                            FontSize="14"
                            FontAttributes="Bold"
                            TextColor="White"/>
                    <Label x:Name="CartTotalPriceLabel"
                            Text="Rp 0"
                            FontSize="12"
                            TextColor="#D0D0D0"/>
                </VerticalStackLayout>
                <Label Text="→"
                        Grid.Column="2"
                        FontSize="20"
                        TextColor="White"
                        VerticalOptions="Center"/>
            </Grid>
        </Border>
    </Grid>
</ContentPage>
