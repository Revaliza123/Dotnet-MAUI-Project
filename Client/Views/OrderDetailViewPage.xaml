<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectMaui.Client.Views.OrderDetailViewPage"
             BackgroundColor="#F4F1EA"
             Title="Detail Pesanan">

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Header -->
        <VerticalStackLayout Grid.Row="0" Padding="20,10" Spacing="4">
            <Label Text="Detail Pesanan"
                   FontSize="24"
                   FontAttributes="Bold"
                   TextColor="#1E3A5F"/>
            <Label x:Name="OrderDateLabel"
                   FontSize="14"
                   TextColor="Gray"/>
        </VerticalStackLayout>

        <!-- Order Items -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="20,10" Spacing="12" x:Name="ItemsContainer"/>
        </ScrollView>

        <!-- Footer -->
        <VerticalStackLayout Grid.Row="2"
                             Padding="20,16"
                             BackgroundColor="White"
                             Spacing="8">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Total"
                       FontSize="16"
                       TextColor="#555"
                       VerticalOptions="Center"/>
                <Label x:Name="TotalLabel"
                       Grid.Column="1"
                       Text="Rp 0"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="#1E3A5F"
                       VerticalOptions="Center"/>
            </Grid>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
