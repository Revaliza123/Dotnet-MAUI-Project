<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectMaui.Client.Views.LoginPage"
             BackgroundColor="#F4F1EA"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="28,60,28,28" Spacing="24">

            <!-- Logo / Header -->
            <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                <Label Text="🍽️"
                       FontSize="56"
                       HorizontalOptions="Center"/>
                <Label Text="Resto Orders"
                       FontSize="26"
                       FontAttributes="Bold"
                       TextColor="#1E3A5F"
                       HorizontalOptions="Center"/>
                <Label Text="Masuk ke akun Anda"
                       FontSize="14"
                       TextColor="Gray"
                       HorizontalOptions="Center"/>
            </VerticalStackLayout>

            <!-- Login Card -->
            <Border StrokeShape="RoundRectangle 16"
                    BackgroundColor="White"
                    StrokeThickness="0">
                <Border.Shadow>
                    <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                </Border.Shadow>
                <VerticalStackLayout Padding="24" Spacing="16">

                    <!-- Username -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Username"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="#F5F5F5"
                                StrokeThickness="0">
                            <Entry x:Name="UsernameEntry"
                                   Placeholder="Masukkan username"
                                   PlaceholderColor="#9E9E9E"
                                   BackgroundColor="Transparent"
                                   Margin="4,0"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Password -->
                    <VerticalStackLayout Spacing="6">
                        <Label Text="Password"
                               FontSize="14"
                               FontAttributes="Bold"
                               TextColor="#1E3A5F"/>
                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="#F5F5F5"
                                StrokeThickness="0">
                            <Entry x:Name="PasswordEntry"
                                   Placeholder="Masukkan password"
                                   PlaceholderColor="#9E9E9E"
                                   IsPassword="True"
                                   BackgroundColor="Transparent"
                                   Margin="4,0"/>
                        </Border>
                    </VerticalStackLayout>

                    <!-- Error Label -->
                    <Label x:Name="ErrorLabel"
                           Text=""
                           FontSize="13"
                           TextColor="#E74C3C"
                           HorizontalOptions="Center"
                           IsVisible="False"/>

                    <!-- Login Button -->
                    <Button x:Name="LoginButton"
                            Text="Masuk"
                            BackgroundColor="#1E3A5F"
                            TextColor="White"
                            FontSize="15"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            HeightRequest="50"
                            Margin="0,4,0,0"
                            Clicked="OnLoginClicked"/>

                </VerticalStackLayout>
            </Border>

            <!-- Loading Indicator -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="#1E3A5F"
                               HorizontalOptions="Center"/>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
