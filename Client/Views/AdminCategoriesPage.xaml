<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:ProjectMaui.Domain.Models"
             x:Class="ProjectMaui.Client.Views.AdminCategoriesPage"
             BackgroundColor="#F4F1EA"
             Title="Categories">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!--  Add Category Button  -->
            <Button Text="+ Add Category"
                    BackgroundColor="#1E3A5F"
                    TextColor="White"
                    CornerRadius="20"
                    HeightRequest="48"
                    FontSize="15"
                    FontAttributes="Bold"
                    Clicked="OnAddCategoryClicked"/>

            <!--  Category List  -->
            <CollectionView x:Name="categoriesItemsView">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Category">
                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                Margin="0,0,0,12">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                            </Border.Shadow>
                            <VerticalStackLayout Padding="16" Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           TextColor="#1E3A5F"/>
                                    <HorizontalStackLayout Grid.Column="1"
                                                           Spacing="6"
                                                           VerticalOptions="Center">
                                        <Button Text="✏️"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                BackgroundColor="#E3F2FD"
                                                TextColor="#1E3A5F"
                                                CornerRadius="8"
                                                FontSize="14"
                                                Clicked="OnEditClicked"
                                                CommandParameter="{Binding Id}"/>
                                        <Button Text="🗑️"
                                                WidthRequest="36"
                                                HeightRequest="36"
                                                BackgroundColor="#FFEBEE"
                                                TextColor="#D32F2F"
                                                CornerRadius="8"
                                                FontSize="14"
                                                Clicked="OnDeleteClicked"
                                                CommandParameter="{Binding Id}"/>
                                    </HorizontalStackLayout>
                                </Grid>
                                <Label Text="{Binding Description}"
                                       FontSize="13"
                                       TextColor="Gray"
                                       MaxLines="2"/>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  Empty State  -->
            <VerticalStackLayout x:Name="emptyState"
                                 IsVisible="False"
                                 Spacing="8"
                                 VerticalOptions="Center">
                <Label Text="No categories found"
                       FontSize="18"
                       HorizontalOptions="Center"
                       TextColor="#1E3A5F"
                       FontAttributes="Bold"/>
                <Label Text="Click '+ Add Category' to create a new category"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="Gray"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
