<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectMaui.Client.Views.AdminTablesPage"
             BackgroundColor="#F4F1EA"
             Title="Manage Tables">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16">

            <!--  Table List  -->
            <CollectionView x:Name="TablesCollectionView">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border StrokeShape="RoundRectangle 16"
                                BackgroundColor="White"
                                StrokeThickness="0"
                                Margin="0,0,0,12">
                            <Border.Shadow>
                                <Shadow Brush="Black" Offset="0,2" Radius="5" Opacity="0.1"/>
                            </Border.Shadow>
                            <VerticalStackLayout Padding="16" Spacing="10">

                                <!--  Header: Table Number, Area, Capacity + Status Badge  -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="{Binding TableNumberText}"
                                               FontSize="18"
                                               FontAttributes="Bold"
                                               TextColor="#1E3A5F"/>
                                        <Label Text="{Binding AreaText}"
                                               FontSize="12"
                                               TextColor="Gray"/>
                                        <Label Text="{Binding CapacityText}"
                                               FontSize="12"
                                               TextColor="Gray"/>
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            BackgroundColor="{Binding StatusColor}"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="8,4">
                                        <Label Text="{Binding StatusText}"
                                               FontSize="11"
                                               FontAttributes="Bold"
                                               TextColor="White"/>
                                    </Border>
                                </Grid>

                                <!--  Status Change Row  -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Ubah Status:"
                                           FontSize="13"
                                           TextColor="#555555"/>
                                    <HorizontalStackLayout Spacing="6">
                                        <Button Text="Available"
                                              BackgroundColor="{Binding AvailableBtnColor}"
                                              TextColor="White"
                                              FontSize="11"
                                              HeightRequest="28"
                                              CornerRadius="8"
                                              Clicked="OnSetStatusClicked"
                                              CommandParameter="{Binding Id}"
                                              IsEnabled="{Binding CanChangeStatus}"/>
                                        <Button Text="Reserved"
                                              BackgroundColor="{Binding ReservedBtnColor}"
                                              TextColor="White"
                                              FontSize="11"
                                              HeightRequest="28"
                                              CornerRadius="8"
                                              Clicked="OnSetStatusClicked"
                                              CommandParameter="{Binding Id}"
                                              IsEnabled="{Binding CanChangeStatus}"/>
                                        <Button Text="Cleaning"
                                              BackgroundColor="{Binding CleaningBtnColor}"
                                              TextColor="White"
                                              FontSize="11"
                                              HeightRequest="28"
                                              CornerRadius="8"
                                              Clicked="OnSetStatusClicked"
                                              CommandParameter="{Binding Id}"
                                              IsEnabled="{Binding CanChangeStatus}"/>
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>

                                <!--  Delete Button  -->
                                <HorizontalStackLayout HorizontalOptions="End">
                                    <Button Text="🗑️ Hapus Meja"
                                            BackgroundColor="Transparent"
                                            TextColor="#E74C3C"
                                            FontSize="13"
                                            HeightRequest="30"
                                            Clicked="OnDeleteClicked"
                                            CommandParameter="{Binding Id}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!--  Empty State  -->
            <VerticalStackLayout x:Name="emptyState"
                                 IsVisible="False"
                                 Spacing="8"
                                 VerticalOptions="Center">
                <Label Text="Tidak ada data meja"
                       FontSize="18"
                       HorizontalOptions="Center"
                       TextColor="#1E3A5F"
                       FontAttributes="Bold"/>
                <Label Text="Meja akan ditampilkan di sini setelah ditambahkan"
                       FontSize="14"
                       HorizontalOptions="Center"
                       TextColor="Gray"/>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
