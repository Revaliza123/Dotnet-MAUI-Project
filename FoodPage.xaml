<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ProjectMaui.FoodPage"
             BackgroundColor="#F4F1EA"
             Title="Menu GoDahar">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">
            
            <Grid ColumnDefinitions="*, Auto">
                <VerticalStackLayout Grid.Column="0">
                    <Label Text="GoDahar" FontSize="28" FontAttributes="Bold" TextColor="#1E3A5F" />
                    <Label Text="Pesan makanan favoritmu!" FontSize="14" TextColor="Gray" />
                </VerticalStackLayout>
                
                <Frame Grid.Column="1" HeightRequest="45" WidthRequest="45" CornerRadius="22.5" Padding="0" BackgroundColor="White" HasShadow="True">
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCartIconTapped" />
                    </Frame.GestureRecognizers>
                    <Label Text="&#x1F6D2;" HorizontalOptions="Center" VerticalOptions="Center" FontSize="20"/>
                </Frame>
            </Grid>

            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="15">
                    <Button Text="All Menu" Clicked="OnCategoryClicked" BackgroundColor="Transparent" TextColor="#1E3A5F" BorderColor="#1E3A5F" BorderWidth="1" CornerRadius="20" HeightRequest="40" Padding="20,0"/>
                    <Button Text="Food" Clicked="OnCategoryClicked" BackgroundColor="#1E3A5F" TextColor="White" CornerRadius="20" HeightRequest="40" Padding="20,0"/>
                    <Button Text="Drinks" Clicked="OnCategoryClicked" BackgroundColor="Transparent" TextColor="#1E3A5F" BorderColor="#1E3A5F" BorderWidth="1" CornerRadius="20" HeightRequest="40" Padding="20,0"/>
                    <Button Text="Dessert" Clicked="OnCategoryClicked" BackgroundColor="Transparent" TextColor="#1E3A5F" BorderColor="#1E3A5F" BorderWidth="1" CornerRadius="20" HeightRequest="40" Padding="20,0"/>
                </HorizontalStackLayout>
            </ScrollView>

            <Label Text="Kategori: Food 🍛" FontSize="18" FontAttributes="Bold" TextColor="#1E3A5F" />

            <Grid RowDefinitions="Auto" ColumnDefinitions="*, *" RowSpacing="15" ColumnSpacing="15">
                <Frame Grid.Row="0" Grid.Column="0" CornerRadius="20" Padding="0" HasShadow="True" BackgroundColor="White" BorderColor="Transparent">
                    <VerticalStackLayout>
                        <BoxView Color="#D1D5DB" HeightRequest="120" CornerRadius="20,20,0,0" />
                        <StackLayout Padding="12">
                            <Label Text="Nasi Goreng Spesial" FontSize="16" FontAttributes="Bold" TextColor="#1E3A5F" />
                            <Label Text="Nasi, telur, ayam, kerupuk..." FontSize="12" TextColor="Gray" MaxLines="2" Margin="0,5,0,0"/>
                            <Grid ColumnDefinitions="*, Auto" Margin="0,15,0,0">
                                <Label Text="Rp 25.000" FontSize="14" FontAttributes="Bold" TextColor="#1E3A5F" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="+" Clicked="OnAddToCartClicked" BackgroundColor="#1E3A5F" TextColor="White" WidthRequest="30" HeightRequest="30" CornerRadius="15" Padding="0" VerticalOptions="Center"/>
                            </Grid>
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1" CornerRadius="20" Padding="0" HasShadow="True" BackgroundColor="White" BorderColor="Transparent">
                    <VerticalStackLayout>
                        <BoxView Color="#D1D5DB" HeightRequest="120" CornerRadius="20,20,0,0" />
                        <StackLayout Padding="12">
                            <Label Text="Ayam Bakar Madu" FontSize="16" FontAttributes="Bold" TextColor="#1E3A5F" />
                            <Label Text="Ayam kampung, bumbu madu..." FontSize="12" TextColor="Gray" MaxLines="2" Margin="0,5,0,0"/>
                            <Grid ColumnDefinitions="*, Auto" Margin="0,15,0,0">
                                <Label Text="Rp 30.000" FontSize="14" FontAttributes="Bold" TextColor="#1E3A5F" VerticalOptions="Center" />
                                <Button Grid.Column="1" Text="+" Clicked="OnAddToCartClicked" BackgroundColor="#1E3A5F" TextColor="White" WidthRequest="30" HeightRequest="30" CornerRadius="15" Padding="0" VerticalOptions="Center"/>
                            </Grid>
                        </StackLayout>
                    </VerticalStackLayout>
                </Frame>
            </Grid>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>